{
  "name": "ompchamber",
  "version": "0.8.0",
  "description": "Developer web console and diagnostic chamber for AI Oh-My-Pi — Elysia + Preact on Bun.",
  "license": "UNLICENSED",
  "author": "Wijanarko Putra Rajeb <wijanarko.rajeb@gmail.com>",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "ompchamber": "./src/cli/ompchamber.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajebdev/ompchamber.git"
  },
  "homepage": "https://github.com/rajebdev/ompchamber#readme",
  "bugs": {
    "url": "https://github.com/rajebdev/ompchamber/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "agent",
    "console",
    "elysia",
    "preact",
    "bun"
  ],
  "files": [
    "src",
    "dist/client",
    "tsconfig.json"
  ],
  "scripts": {
    "dev:server": "NODE_ENV=development bun run --hot src/server/index.ts --ompchamber-server",
    "dev:client": "rsbuild build --watch",
    "dev": "bun run dev:server & bun run dev:client; wait",
    "dev:lan": "HOST=0.0.0.0 bun run dev:server & bun run dev:client; wait",
    "build": "rsbuild build",
    "start": "NODE_ENV=production bun run src/server/index.ts --ompchamber-server",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "elysia": "^1.4.30",
    "katex": "^0.18.7",
    "lucide-preact": "^1.47.0",
    "marked": "^18.0.11",
    "marked-linkify-it": "^4.0.2",
    "mermaid": "^12.0.0",
    "preact": "^10.29.8",
    "remend": "^1.3.1",
    "ripgrep": "^0.3.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.7",
    "@rsbuild/plugin-preact": "^2.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.14.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "happy-dom": "^20.14.5",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
